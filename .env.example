# Run scripts/setup_env.py to generate local development secrets.
SEEKDB_IMAGE=oceanbase/seekdb@sha256:4db4961869d554313520d6081fca29265ba6da6db7313311bd8acbed771a956b
SEEKDB_ROOT_PASSWORD=replace-with-local-secret
DB_HOST=127.0.0.1
DB_PORT=2881
DB_NAME=course_assistant
DB_USER=course_app
DB_PASSWORD=replace-with-local-secret
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
DEMO_PASSWORD=LearnDemo2026!
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_POLL_SECONDS=2
WORKER_TASK_TIMEOUT_SECONDS=120
# Obtain a Beijing workspace ID and matching API Key from Alibaba Cloud Model Studio.
# Leave the key blank until ready. Never commit the real .env.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_CHUNKS_PER_DOCUMENT=32
RETRIEVAL_REQUESTS_PER_MINUTE=6
RETRIEVAL_DEADLINE_SECONDS=60
# DeepSeek answer generation is selected but not implemented/configured yet.
